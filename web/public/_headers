# Response headers for the static files the asset layer serves itself (Workers Static Assets reads
# this file): the icons, the manifest, the service worker, the card image, robots.txt and the hashed
# bundles. Every HTML page is the Worker's, with its own headers and Content-Security-Policy
# (worker/headers.ts); /api/* sets its own in worker/proxy.ts and worker/headers.ts.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Hashed bundles never change under their names: cache them for a year, never revalidate.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
